# -----------------------------------------------------------------------------
# Public environment variables (safe to expose to the browser via NEXT_PUBLIC_*)
# Copy this file to `.env.local` and fill in your real values.
# -----------------------------------------------------------------------------

# --- Brand & contact (single source of truth for phone + URL) ----------------
# Canonical site URL (used for metadata, sitemap, robots, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Phone number shown on buttons (human readable)
NEXT_PUBLIC_PHONE_DISPLAY=(800) 000-0000
# Same number in E.164 format (used in tel: links and structured data)
NEXT_PUBLIC_PHONE_E164=+18000000000

# Non-urgent contact email (contact page only)
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com

# --- Tracking ----------------------------------------------------------------
# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Ads conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=YYYYYY

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- Feature flags -----------------------------------------------------------
# Set to "true" to allow policy/utility pages to be indexed.
# Leave empty/false to keep /privacy-policy, /terms and /contact out of search.
NEXT_PUBLIC_INDEX_UTILITY_PAGES=false
